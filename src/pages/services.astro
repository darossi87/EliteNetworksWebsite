---
import Base from '../layouts/Base.astro';
const services=[
{num:'01',name:'Managed IT Services',desc:'Day-to-day IT operations and proactive support that help your team stay productive.',list:['Remote help desk and troubleshooting','On-site support','24/7 monitoring and alerts','Windows and server patch management','Workstation and server management','IT procurement and deployment']},
{num:'02',name:'Cybersecurity & Compliance',desc:'Practical tools and guidance to strengthen security across your organization.',list:['Endpoint protection, EDR, and antivirus','Managed firewalls and network security','Microsoft 365 security, MFA, and Conditional Access','Email security and anti-phishing','Security assessments and vulnerability scanning','HIPAA-related IT security and compliance support']},
{num:'03',name:'Microsoft 365 & Cloud',desc:'Modern workplace administration, migrations, and cloud infrastructure.',list:['Microsoft 365 administration and migrations','Microsoft Azure and cloud infrastructure','Entra ID and identity management','Microsoft Intune device management','Email migrations and administration','Cloud backup solutions']},
{num:'04',name:'Networks & Infrastructure',desc:'Reliable, secure networks and infrastructure for offices and distributed teams.',list:['Business networking, switches, and Wi-Fi','VPN and remote connectivity','Server deployment and virtualization','Network cabling and installation']},
{num:'05',name:'Backup & Disaster Recovery',desc:'Solutions to help you protect data and prepare for unexpected interruptions.',list:['Business backup solutions','Cloud backup','Disaster recovery planning and support']},
{num:'06',name:'Business Phone Systems',desc:'Communication systems that help your organization stay connected.',list:['VoIP and business phone systems','Deployment and ongoing technical support']}
];
---
<Base title="IT Services | Elite Networks" description="Managed IT, cybersecurity, Microsoft 365, Azure, networking, backups and VoIP services for small and mid-sized businesses."><section class="page-hero shell"><p class="eyebrow">OUR EXPERTISE</p><h1>Technology solutions.<br/><span>Built around your business.</span></h1><p>Managed IT, security, cloud, and infrastructure services for organizations that need reliable technology without unnecessary complexity.</p></section><section class="shell service-detail-grid">{services.map(service=><article class="service-detail"><div class="eyebrow">{service.num} / SERVICES</div><h2>{service.name}</h2><p>{service.desc}</p><ul>{service.list.map(item=><li>{item}</li>)}</ul><a class="text-link" href={`/contact/?service=${encodeURIComponent(service.name)}`}>Ask about this service ↗</a></article>)}</section><section class="shell final-cta"><div><p class="eyebrow">CUSTOM IT SOLUTIONS</p><h2>Let's find the right fit.</h2><p>Tell us what you need. We'll provide a quote based on your environment.</p></div><a class="btn" href="/contact/">Get a Quote ↗</a></section></Base>
