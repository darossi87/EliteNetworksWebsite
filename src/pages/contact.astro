---
import Base from '../layouts/Base.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const options=['Managed IT Services','Cybersecurity','Microsoft 365 & Cloud','Networks & Infrastructure','Backup & Disaster Recovery','Business Phone Systems','General IT / Other'];
---
<Base title="Contact Elite Networks | Request an IT Quote" description="Contact Elite Networks for managed IT services, cybersecurity, cloud solutions, networking and business IT projects."><section class="page-hero shell contact-header"><p class="eyebrow">GET IN TOUCH</p><h1>Let's talk about <span>your IT.</span></h1><p>Tell us what your business needs. Our team will review your inquiry and get back to you.</p></section><section class="shell contact-grid"><div class="contact-form-wrap"><h2>Send us a message</h2><p>Request a custom quote or ask a question.</p><form id="contact-form"><div class="form-row"><label>Full name <span>*</span><input name="name" required minlength="2" maxlength="100" autocomplete="name" placeholder="Your name" /></label><label>Business email <span>*</span><input type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@company.com" /></label></div><label>Company name<input name="company" maxlength="120" autocomplete="organization" placeholder="Your company" /></label><label>What can we help you with? <span>*</span><select name="service" required>{options.map(o=><option value={o}>{o}</option>)}</select></label><label>Message <span>*</span><textarea name="message" required minlength="10" maxlength="4000" rows="6" placeholder="Tell us a little about your business and what you're looking for..."></textarea></label><div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div><p class="form-note">Please don't send passwords, medical records, or other sensitive information through this form.</p><button type="submit" class="btn" id="submit-button">Send Message ↗</button><div id="form-status" role="status" aria-live="polite"></div></form></div><aside class="contact-aside"><p class="eyebrow">CONTACT DETAILS</p><div><h3>Email us</h3><a href="mailto:sales@elitenetworks.net">sales@elitenetworks.net ↗</a></div><div><h3>Give us a call</h3><a href="tel:+17275146903">(727) 514-6903 ↗</a></div><div><h3>On-site support</h3><p>Seattle Area, Washington<br/>Tampa Bay Area, Florida</p></div><div><h3>Remote support</h3><p>Available nationwide</p></div><div class="aside-note"><b>Existing customers</b><p>Business-hours support with emergency after-hours support for existing customers.</p></div></aside></section>
<script is:inline>
(function(){
const form=document.getElementById('contact-form'),status=document.getElementById('form-status'),button=document.getElementById('submit-button');
const search=new URLSearchParams(window.location.search), service=search.get('service');
if(service){ const select=form.elements.service; for(const option of select.options){ if(option.value===service || (service==='Microsoft 365 & Cloud' && option.value==='Microsoft 365 & Cloud')){select.value=option.value;break;} } }
form.addEventListener('submit',async e=>{e.preventDefault();button.disabled=true;button.textContent='Sending…';status.textContent='';const data=Object.fromEntries(new FormData(form));try{const res=await fetch('/api/contact',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw Error('Contact API returned a non-JSON response (HTTP '+res.status+'). Verify the Vercel function deployment');const result=await res.json();if(!res.ok)throw Error(result.error||'Unable to send your message.');form.reset();status.textContent='Message received. Thank you! We will be in touch.';status.className='success';if(window.turnstile)window.turnstile.reset();}catch(error){status.textContent=error.message+'. You can also email sales@elitenetworks.net.';status.className='error';}finally{button.disabled=false;button.textContent='Send Message ↗';}});
})();
</script><script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Base>
