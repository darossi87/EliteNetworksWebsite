---
import Base from '../layouts/Base.astro';
const services=[
{icon:'◈',name:'Managed IT Services',description:'Proactive monitoring, reliable support, patch management, and everyday IT operations.'},
{icon:'⬡',name:'Cybersecurity',description:'Protect your business with endpoint security, managed firewalls, and risk assessments.'},
{icon:'☁',name:'Microsoft 365 & Cloud',description:'Microsoft 365, Azure, Entra ID, Intune, cloud migrations, and administration.'},
{icon:'⌘',name:'Network & Infrastructure',description:'Secure business networking, Wi-Fi, VPNs, cabling, servers, and virtualization.'},
{icon:'↻',name:'Backup & Recovery',description:'Backup solutions and recovery planning to help protect critical business data.'},
{icon:'◉',name:'Business Communications',description:'Deployment and ongoing support for VoIP and business telephone systems.'}
];
---
<Base>
<section class="hero"><div class="hero-glow"></div><div class="shell hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> MANAGED IT SERVICES & CYBERSECURITY</p><h1>Your business deserves <span>better IT support.</span></h1><p class="hero-lead">Reliable technology. Stronger security. Real people who answer the phone. Personalized managed IT services for businesses that value responsive, knowledgeable support.</p><div class="cta-row"><a class="btn" href="/contact/">Talk to an IT Expert <span aria-hidden="true">↗</span></a><a class="btn-outline" href="/services/">Explore Services <span aria-hidden="true">→</span></a></div><div class="hero-meta"><span><strong>Since 2011</strong><small>Serving businesses</small></span><span><strong>24/7</strong><small>Proactive monitoring</small></span><span><strong>Nationwide</strong><small>Remote support</small></span></div></div><div class="hero-visual" aria-hidden="true"><div class="visual-grid"></div><div class="visual-ring ring-1"></div><div class="visual-ring ring-2"></div><div class="logo-orb"><img src="/logos/elite-icon.svg" alt="" width="245" height="245" /></div><div class="floating-tag tag-one"><span class="status-dot"></span> Proactive Monitoring</div><div class="floating-tag tag-two">Security-first solutions <span>✓</span></div></div></div></section>
<section class="trust-strip"><div class="shell"><span>BUILT FOR SMALL & MID-SIZED BUSINESSES</span><span>PERSONAL SUPPORT</span><span>COMPREHENSIVE IT SERVICES</span><span>SEATTLE · TAMPA BAY · NATIONWIDE</span></div></section>
<section class="section shell"><div class="section-intro"><p class="eyebrow">WHAT WE DO</p><h2>Everything your business needs.<br/><span>Nothing it doesn't.</span></h2><p>From everyday IT support to complex cybersecurity and infrastructure projects, we're here to make technology work for you.</p></div><div class="service-grid">{services.map(service=><article class="service-card"><div class="service-icon">{service.icon}</div><h3>{service.name}</h3><p>{service.description}</p><a href="/services/" aria-label={`Learn more about ${service.name}`}>Explore service <span aria-hidden="true">↗</span></a></article>)}</div></section>
<section class="section section-panel"><div class="shell split"><div><p class="eyebrow">THE ELITE NETWORKS DIFFERENCE</p><h2>Enterprise-level expertise.<br/><span>Small-business attention.</span></h2><p>Technology problems shouldn't mean endless hold times or explaining the same issue to multiple technicians. We take the time to know your business, understand your environment, and deliver practical solutions.</p><a class="text-link" href="/about/">Get to know Elite Networks ↗</a></div><div class="value-list"><div><b>01</b><div><h3>Real people. Responsive support.</h3><p>A personal approach focused on helping you get back to business.</p></div></div><div><b>02</b><div><h3>Proactive by design.</h3><p>24/7 monitoring and ongoing maintenance to help catch issues early.</p></div></div><div><b>03</b><div><h3>Built around your business.</h3><p>Managed services, per-device pricing, and project support tailored to your needs.</p></div></div></div></div></section>
<section class="section shell regional"><div><p class="eyebrow">WHERE WE WORK</p><h2>Local presence.<br/><span>Nationwide reach.</span></h2><p>Hands-on support in the Seattle and Tampa Bay areas, plus remote IT services for businesses across the United States.</p></div><div class="region-cards"><div><span>01 / WASHINGTON</span><h3>Seattle Area</h3><p>On-site IT services</p></div><div><span>02 / FLORIDA</span><h3>Tampa Bay Area</h3><p>On-site IT services</p></div><div><span>03 / UNITED STATES</span><h3>Nationwide</h3><p>Remote IT support</p></div></div></section>
<section class="shell final-cta"><div><p class="eyebrow">LET'S GET STARTED</p><h2>Let's make IT the<br/><span>least of your worries.</span></h2><p>Tell us about your business and we'll discuss an IT solution that fits.</p></div><a class="btn" href="/contact/">Request a Custom Quote ↗</a></section>
</Base>
