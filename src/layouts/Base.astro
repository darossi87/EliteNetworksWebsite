---
import '../styles.css';
const {title = 'Elite Networks | Managed IT Services & Cybersecurity', description = 'Personalized managed IT services, cybersecurity, Microsoft 365 and network solutions. On-site in Seattle and Tampa Bay, remote nationwide.'} = Astro.props;
const pathname = Astro.url.pathname;
const nav = [{href:'/',name:'Home'},{href:'/services/',name:'Services'},{href:'/about/',name:'About'},{href:'/contact/',name:'Contact'}];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#081322" />
<meta name="description" content={description}/>
<link rel="icon" type="image/svg+xml" href="/logos/elite-icon.svg" />
<link rel="canonical" href={new URL(pathname, Astro.site).toString()} />
<title>{title}</title>
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
</head>
<body>
<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="Elite Networks home"><img class="brand-wide" src="/logos/elite-horizontal-inverted.svg" alt="Elite Networks" width="245" height="36" /><img class="brand-small" src="/logos/elite-icon.svg" alt="Elite Networks" width="42" height="42" /></a>
    <nav aria-label="Main navigation" class="nav"><div class="nav-links">{nav.map((link)=><a href={link.href} aria-current={pathname===link.href?'page':undefined}>{link.name}</a>)}</div><a class="btn btn-sm" href="/contact/">Get a Quote <span aria-hidden="true">↗</span></a></nav>
    <button class="menu-toggle" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
  <nav id="mobile-menu" class="mobile-menu shell" aria-label="Mobile navigation" hidden>{nav.map((link)=><a href={link.href}>{link.name}</a>)}<a href="/contact/" class="btn">Get a Quote ↗</a></nav>
</header>
<main><slot /></main>
<footer class="site-footer"><div class="shell footer-top"><div><img src="/logos/elite-horizontal-inverted.svg" alt="Elite Networks" width="230" height="34"/><p>Personalized IT support. Business-grade technology.</p><p class="footer-geography">Seattle, WA · Tampa Bay, FL · Remote Nationwide</p></div><div><h3>Explore</h3><a href="/">Home</a><a href="/services/">Services</a><a href="/about/">About</a><a href="/contact/">Contact</a></div><div><h3>Get in touch</h3><a href="tel:+17275146903">(727) 514-6903</a><a href="mailto:sales@elitenetworks.net">sales@elitenetworks.net</a><small>Business-hours support. Emergency after-hours support for existing customers.</small></div></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Elite Networks. All rights reserved.</span><span>Established 2011</span></div></footer>
<script is:inline>
  const menuToggle = document.querySelector('.menu-toggle'); const mobileMenu = document.querySelector('#mobile-menu');
  menuToggle?.addEventListener('click', () => { const open = menuToggle.getAttribute('aria-expanded') !== 'true'; menuToggle.setAttribute('aria-expanded', String(open)); mobileMenu.hidden = !open; });
</script>
</body></html>
